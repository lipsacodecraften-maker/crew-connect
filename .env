# PostgreSQL connection string for Prisma
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:admin@localhost:5432/crewconnect?schema=public"

# Public base URL used in email / WhatsApp tracking links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy SQLite path (no longer used after PostgreSQL/Prisma migration)
# BOOKING_DATABASE_PATH=C:\absolute\path\to\crewconnect.db

# Admin alert recipients
ADMIN_EMAIL=bookings@crewconnect.example
ADMIN_WHATSAPP_NUMBER=+919876543210

# Email integration (Resend)
RESEND_API_KEY=
EMAIL_FROM=CrewConnect Bookings <bookings@crewconnect.example>

# WhatsApp Cloud API integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protects PATCH /api/bookings/:bookingId/status
# Also protects the staff registration admin endpoints.
ADMIN_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Staff registration (/join-as-staff)
# ---------------------------------------------------------------------------

# 32-byte key used to encrypt profile photos and supporting documents at rest.
# Accepts a 64-char hex string, a base64-encoded 32-byte value, or any passphrase
# (which is hashed with SHA-256). When unset, a key is generated on first use at
# data/staff-documents.key. Set this in production so backups stay decryptable.
# STAFF_DOCUMENT_ENCRYPTION_KEY=

# Secret used to hash WhatsApp OTP codes. Falls back to the document key.
# Set a stable value in production so pending codes survive restarts.
# OTP_HASH_SECRET=

# WhatsApp OTP delivery reuses WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID from above. Without them, non-production
# environments return a local dev code instead of sending a message.

